{
  "name": "@invadelol/ui",
  "version": "0.2.1",
  "description": "Invade's frontend: design tokens, primitives and the match and profile views shared by the desktop app and invade.lol.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invadelol/ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logic": {
      "types": "./dist/types/logic/index.d.ts",
      "import": "./dist/logic.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens-light.css": "./dist/tokens-light.css",
    "./keys.json": "./dist/keys.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test 'test/*.test.ts'"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "histoire": "1.0.0-beta.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@11.17.0"
}
